# Populate BEFORE next build and also provide at next start.
# Leave HOMES_BUILD_PROFILE unset for deployable production.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=https://dnbhomes.com
# Exact public HTTPS media origins matching S3_PUBLIC_URL, comma separated.
NEXT_PUBLIC_MEDIA_ORIGINS=
# Optional; absent keeps downloads/contact actions disabled.
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Final Play APP SIGNING SHA-256 certificate fingerprints, comma separated.
ANDROID_APP_LINK_FINGERPRINTS=
