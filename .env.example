NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=+256747877740

# Social sign-in buttons appear only when the backend capabilities endpoint
# confirms the provider is enabled and the matching public client ID is set.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Builds default to strict production validation. For LOCAL build/start checks only:
# HOMES_BUILD_PROFILE=local
# Real production must set public HTTPS API/site URLs and explicit HTTPS media origins.
NEXT_PUBLIC_MEDIA_ORIGINS=
# Final PLAY APP SIGNING certificate SHA-256 fingerprints, comma separated.
# Absent means /.well-known/assetlinks.json returns 404 until verified values exist.
ANDROID_APP_LINK_FINGERPRINTS=

# Real ten-character Apple team ID; absent keeps AASA disabled.
IOS_APP_LINK_TEAM_ID=
# Server-only independent secret shared with backend for authenticated client-IP forwarding.
# Required for hosted Vercel account requests; never NEXT_PUBLIC.
CONSUMER_WEB_PROXY_SECRET=
